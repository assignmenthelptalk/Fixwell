---
import { site } from '../data/site';
---

<div class="call-bar" role="complementary" aria-label="Quick contact">
  <a href={`tel:${site.phone}`} class="call-bar__btn call-bar__btn--call">
    <span aria-hidden="true">📞</span> Call Now
  </a>
</div>

<style>
  .call-bar { display: none; }

  @media (max-width: 900px) {
    .call-bar {
      position: fixed;
      bottom: 0;
      left: 0;
      right: 0;
      z-index: 90;
      display: flex;
      gap: .5rem;
      padding: .5rem .75rem calc(.5rem + env(safe-area-inset-bottom));
      background: white;
      box-shadow: 0 -2px 10px rgba(0,0,0,.12);
    }
    .call-bar__btn {
      flex: 1;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: .5rem;
      padding: .85rem 1rem;
      border-radius: var(--radius);
      font-weight: 700;
      font-size: 1rem;
      line-height: 1;
    }
    .call-bar__btn--call { background: var(--orange); color: white; }
    .call-bar__btn--call:active { background: var(--orange-dark); }

    /* keep footer content clear of the fixed bar */
    :global(body) { padding-bottom: 4.5rem; }
  }
</style>
