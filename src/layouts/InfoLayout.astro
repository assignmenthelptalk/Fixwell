---
import BaseLayout from './BaseLayout.astro';
import BreadcrumbNav from '../components/BreadcrumbNav.astro';
import { getEntry } from 'astro:content';
import { site } from '../data/site';
import { articleMeta, formatArticleDate } from '../data/articleMeta';

interface Props {
  title: string;
  description: string;
  h1: string;
  slug: string;
  faqs?: { q: string; a: string }[];
}

const { title, description, h1, slug, faqs = [] } = Astro.props;

const meta = articleMeta[slug];
const credentials = (await getEntry('trustBadges', 'main'))?.data;
const authorName = credentials?.ownerName ?? site.name;

const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: 'Advice', href: '/advice' },
  { label: h1, href: `/${slug}` },
];

const wordCount = 800;
const readTime = Math.ceil(wordCount / 200);

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: h1,
  description,
  url: `${site.url}/${slug}`,
  author: credentials?.ownerName
    ? { '@type': 'Person', name: credentials.ownerName, worksFor: { '@type': 'Organization', name: site.name, url: site.url } }
    : { '@type': 'Organization', name: site.name, url: site.url },
  publisher: {
    '@type': 'Organization',
    name: site.name,
    url: site.url,
  },
  ...(meta ? { datePublished: meta.published, dateModified: meta.updated } : {}),
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: breadcrumbs.map((b, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: b.label,
    item: b.href.startsWith('http') ? b.href : `${site.url}${b.href}`,
  })),
};

const faqSchema = faqs.length > 0 ? {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
} : null;

const schemas = [articleSchema, breadcrumbSchema, ...(faqSchema ? [faqSchema] : [])];
---

<BaseLayout
  title={title}
  description={description}
  schema={schemas}
>
  <BreadcrumbNav crumbs={breadcrumbs} />
  <div class="article-meta">
    <div class="container">
      <a href="/advice" class="tag">Advice</a>
      <span class="read-time">{readTime} min read</span>
      <span class="byline">
        By {authorName}
        {meta && (
          <>
            <span aria-hidden="true"> · </span>Published <time datetime={meta.published}>{formatArticleDate(meta.published)}</time>
            {meta.updated !== meta.published && (
              <>
                <span aria-hidden="true"> · </span>Last updated <time datetime={meta.updated}>{formatArticleDate(meta.updated)}</time>
              </>
            )}
          </>
        )}
      </span>
    </div>
  </div>
  <slot />
</BaseLayout>

<style>
  .article-meta {
    background: var(--bg-light);
    padding: .75rem 0;
    border-bottom: 1px solid var(--border);
  }
  .article-meta .container {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: .5rem 1rem;
  }
  .byline {
    font-size: .875rem;
    color: var(--text-muted);
  }
  .read-time {
    font-size: .875rem;
    color: var(--text-light);
  }
</style>
